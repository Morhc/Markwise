{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markwise",
  "version": "0.1.0",
  "identifier": "com.josh.markwise",
  "build": {
    "beforeDevCommand": "npm run bundle",
    "beforeBuildCommand": "npm run bundle",
    "frontendDist": "../app/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdwn", "mkdn", "text", "txt"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
