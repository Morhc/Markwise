<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed or macOS refuses to load them. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Quick Look grants read access to the previewed FILE only; the images
	     a markdown document references sit beside it and would be denied.
	     This read-only exception lets the preview load them (the same
	     approach QLMarkdown uses). The extension never writes, and the page
	     it produces is rendered with scripts disabled. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
</dict>
</plist>
